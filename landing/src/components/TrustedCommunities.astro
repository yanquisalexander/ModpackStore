---
// components/TrustedCommunities.astro
import { Quote } from "lucide-preact";

const communities = [
  {
    name: "SaltoUruguayServer",
    description:
      "La comunidad confía en nosotros para distribuir y actualizar SaltoCraft.",
    players: "Más de 100 jugadores",
    logo: "https://saltouruguayserver.com/favicon.svg",
    color: "from-blue-500/20 to-purple-500/20", // Opcional: para dar variedad
  },
  {
    name: "PixelSurvival",
    description: "Experiencia de supervivencia única con mods seleccionados.", // Añadí descripción para balancear
    players: "Modpack Custom",
    logo: "/logos/pixelsurvival.png",
    color: "from-green-500/20 to-emerald-500/20",
  },
  {
    name: "Comunidad RedStoneUY",
    description:
      "El punto de encuentro para los amantes de la mecánica técnica.", // Añadí descripción para balancear
    players: "Servidor Técnico",
    logo: "/logos/redstoneuy.png",
    color: "from-red-500/20 to-orange-500/20",
  },
];
---

<section class="relative px-4 py-24 overflow-hidden">
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-indigo-900/20 via-neutral-950 to-neutral-950 -z-10"
  >
  </div>

  <div class="max-w-6xl mx-auto text-center relative z-10">
    <div class="mb-16 space-y-4">
      <h3
        class="text-3xl md:text-5xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-neutral-200 to-neutral-500 tracking-tight"
      >
        Comunidades que confían
      </h3>
      <p class="text-neutral-400 text-lg max-w-2xl mx-auto leading-relaxed">
        Servidores y creadores que usan nuestro launcher para distribuir y
        actualizar sus modpacks sin dolores de cabeza.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        communities.map((c) => (
          <div class="group relative h-full">
            <div
              class={`absolute -inset-0.5 bg-gradient-to-r ${c.color || "from-white/10 to-white/5"} rounded-2xl opacity-0 group-hover:opacity-100 transition duration-500 blur`}
            />

            <div class="relative h-full bg-neutral-900/80 backdrop-blur-xl border border-white/10 rounded-2xl p-8 flex flex-col items-center text-center transition-all duration-300 hover:-translate-y-1 overflow-hidden">
              <Quote
                class="absolute -top-6 -left-6 size-32 text-white/[0.03] -rotate-12 transition-transform duration-500 group-hover:scale-110 group-hover:rotate-0"
                stroke-width={1.5}
              />

              <div class="relative z-10 mb-6 p-3 rounded-full bg-white/5 ring-1 ring-white/10 group-hover:scale-110 transition-transform duration-300">
                <img
                  src={c.logo}
                  alt={c.name}
                  class="h-10 w-10 object-contain"
                  loading="lazy"
                />
              </div>

              <h4 class="relative z-10 text-xl font-bold text-white mb-3 group-hover:text-indigo-300 transition-colors">
                {c.name}
              </h4>

              {c.description && (
                <p class="relative z-10 text-sm text-neutral-400 mb-6 leading-relaxed line-clamp-3">
                  {c.description}
                </p>
              )}

              <div class="relative z-10 mt-auto">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-white/5 text-neutral-300 border border-white/10 group-hover:border-white/20 group-hover:bg-white/10 transition-colors">
                  {c.players}
                </span>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
