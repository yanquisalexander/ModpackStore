---
interface ReleasePlatform {
  browser_download_url?: string;
  url?: string;
}

interface ReleaseData {
  version: string;
  notes: string;
  pub_date: string;
  platforms: Record<string, ReleasePlatform>;
}

const release = Astro.props.release as ReleaseData | undefined;
const releaseVersion = release?.version ?? "canary";
const releaseNotes = release?.notes ?? "Última versión publicada";
---

<section
  id="hero-section"
  class="relative overflow-hidden pb-16 pt-28 lg:pb-20 lg:pt-36"
>
  <div class="relative z-10 mx-auto max-w-6xl px-4">
    <div
      id="hero-badge"
      class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/10 bg-black/20 px-3 py-1.5 opacity-0 backdrop-blur-md"
    >
      <span class="relative flex h-2 w-2">
        <span
          class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400/70"
        ></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-green-400"
        ></span>
      </span>
      <span class="text-xs font-medium tracking-wide text-neutral-300"
        >Versión {releaseVersion}</span
      >
    </div>

    <div class="grid items-start gap-10 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <h1
          id="hero-title"
          class="max-w-3xl text-4xl font-lexend font-bold leading-[1.05] tracking-tight text-white opacity-0 md:text-6xl"
        >
          Tus modpacks, listos para
          <span
            class="block bg-clip-text text-transparent bg-linear-to-r from-ms-primary-light to-ms-secondary"
          >
            jugar en un click.
          </span>
        </h1>

        <p
          id="hero-desc"
          class="mt-6 max-w-2xl text-base leading-relaxed text-neutral-400 opacity-0 md:text-lg"
        >
          Instala modpacks al instante, mantén tus mundos separados y juega sin
          complicaciones. Todo lo que necesitas, nada que no.
        </p>

        <div
          id="hero-meta"
          class="mt-8 grid max-w-2xl gap-3 opacity-0 sm:grid-cols-3"
        >
          <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
            <div
              class="text-[10px] uppercase tracking-[0.24em] text-neutral-500"
            >
              Versión
            </div>
            <div class="mt-1 text-sm font-semibold text-white">
              {releaseVersion}
            </div>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
            <div
              class="text-[10px] uppercase tracking-[0.24em] text-neutral-500"
            >
              Notas
            </div>
            <div class="mt-1 text-sm font-semibold text-white">
              {releaseNotes}
            </div>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
            <div
              class="text-[10px] uppercase tracking-[0.24em] text-neutral-500"
            >
              Estado
            </div>
            <div class="mt-1 text-sm font-semibold text-white">Disponible</div>
          </div>
        </div>

        <div
          id="hero-cta"
          class="mt-8 flex flex-col gap-3 opacity-0 sm:flex-row"
        >
          <a
            href="#download"
            class="inline-flex items-center justify-center rounded-xl bg-ms-primary px-6 py-3 font-semibold text-white transition-colors hover:bg-ms-primary-light"
          >
            Ver descargas
          </a>
          <a
            href="#features"
            class="inline-flex items-center justify-center rounded-xl border border-white/10 bg-white/5 px-6 py-3 font-semibold text-white transition-colors hover:bg-white/10"
          >
            Ver funciones
          </a>
        </div>
      </div>

      <div id="hero-preview" class="relative opacity-0">
        <div class="absolute -inset-4 rounded-[2rem] bg-ms-primary/10 blur-3xl">
        </div>
        <div
          class="relative overflow-hidden rounded-[1.75rem] border border-white/10 bg-[#0c0c0c] shadow-2xl"
        >
          <div
            class="flex items-center justify-between border-b border-white/5 bg-[#141414] px-4 py-3"
          >
            <div class="flex items-center gap-2">
              <span class="h-3 w-3 rounded-full bg-red-500/70"></span>
              <span class="h-3 w-3 rounded-full bg-yellow-500/70"></span>
              <span class="h-3 w-3 rounded-full bg-green-500/70"></span>
            </div>
            <div
              class="text-[10px] uppercase tracking-[0.24em] text-neutral-500"
            >
              Modpack Store
            </div>
            <div class="w-10"></div>
          </div>

          <div class="grid gap-4 p-5 md:grid-cols-[220px_1fr] md:p-6">
            <aside class="rounded-2xl border border-white/10 bg-white/5 p-4">
              <div class="mb-4 flex items-center gap-3">
                <div
                  class="h-10 w-10 rounded-xl bg-linear-to-br from-ms-primary to-ms-secondary"
                >
                </div>
                <div>
                  <div class="h-2.5 w-20 rounded-full bg-white/15"></div>
                  <div class="mt-2 h-2 w-14 rounded-full bg-white/10"></div>
                </div>
              </div>
              <div class="space-y-2 text-sm text-neutral-300">
                <div class="rounded-lg bg-ms-primary/15 px-3 py-2 text-white">
                  Instancias
                </div>
                <div class="rounded-lg px-3 py-2 text-neutral-400">
                  Biblioteca
                </div>
                <div class="rounded-lg px-3 py-2 text-neutral-400">
                  Descargas
                </div>
              </div>
            </aside>

            <div class="rounded-2xl border border-white/10 bg-[#101010] p-5">
              <div
                class="flex items-center justify-between border-b border-white/5 pb-4"
              >
                <div>
                  <div class="h-3 w-28 rounded-full bg-white/20"></div>
                  <div class="mt-2 h-2 w-40 rounded-full bg-white/10"></div>
                </div>
                <div
                  class="rounded-full border border-green-400/20 bg-green-500/10 px-3 py-1 text-[10px] uppercase tracking-[0.2em] text-green-300"
                >
                  Online
                </div>
              </div>

              <div class="mt-4 grid gap-3 sm:grid-cols-2">
                <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                  <div
                    class="text-xs uppercase tracking-[0.22em] text-neutral-500"
                  >
                    Instancia activa
                  </div>
                  <div class="mt-2 text-sm font-semibold text-white">
                    Survival
                  </div>
                  <div class="mt-3 h-2 rounded-full bg-white/10"></div>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                  <div
                    class="text-xs uppercase tracking-[0.22em] text-neutral-500"
                  >
                    Actualización
                  </div>
                  <div class="mt-2 text-sm font-semibold text-white">
                    Lista para instalar
                  </div>
                  <div class="mt-3 h-2 rounded-full bg-ms-primary/40"></div>
                </div>
              </div>

              <div
                class="mt-3 rounded-2xl border border-dashed border-white/10 bg-black/20 p-4 text-sm text-neutral-400"
              >
                Estado, biblioteca y descargas en un solo panel.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({ defaults: { ease: "power3.out" } });

  tl.to("#hero-badge", { opacity: 1, y: 0, duration: 0.7 })
    .to("#hero-title", { opacity: 1, y: 0, duration: 0.9 }, "-=0.3")
    .to("#hero-desc", { opacity: 1, y: 0, duration: 0.8 }, "-=0.5")
    .to("#hero-meta", { opacity: 1, y: 0, duration: 0.7 }, "-=0.4")
    .to("#hero-cta", { opacity: 1, y: 0, duration: 0.7 }, "-=0.4")
    .to("#hero-preview", { opacity: 1, y: 0, duration: 1 }, "-=0.5");

  gsap.to("#hero-preview", {
    scrollTrigger: {
      trigger: "#hero-section",
      start: "top top",
      end: "bottom top",
      scrub: true,
    },
    y: 40,
    scale: 0.98,
    opacity: 0.85,
  });
</script>

<style>
  #hero-badge,
  #hero-title,
  #hero-desc,
  #hero-meta,
  #hero-cta,
  #hero-preview {
    transform: translateY(24px);
  }

  .perspective-distant {
    perspective: 1600px;
  }
</style>
