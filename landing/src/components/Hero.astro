---

---

<section class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden">
  <!-- Background Effects -->
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full z-0 pointer-events-none"
  >
    <div
      class="absolute top-[-10%] left-[-10%] w-[500px] h-[500px] bg-ms-green/20 rounded-full blur-[120px] animate-blob"
    >
    </div>
    <div
      class="absolute top-[20%] right-[-10%] w-[400px] h-[400px] bg-purple-500/10 rounded-full blur-[100px] animate-blob animation-delay-2000"
    >
    </div>
    <div
      class="absolute bottom-[-10%] left-[20%] w-[600px] h-[600px] bg-ms-green/10 rounded-full blur-[120px] animate-blob animation-delay-4000"
    >
    </div>
  </div>

  <div
    class="absolute inset-0 bg-[url('/grid.svg')] bg-center [mask-image:linear-gradient(180deg,white,rgba(255,255,255,0))] opacity-20"
  >
  </div>

  <div class="relative z-10 max-w-screen-xl mx-auto px-4 text-center">
    <div
      class="inline-flex items-center gap-2 px-3 py-1 rounded-full glass-panel mb-8 text-sm text-gray-300 border border-white/10 hover:border-ms-green/50 transition-colors cursor-default"
    >
      <span class="relative flex h-2 w-2">
        <span
          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-ms-green opacity-75"
        ></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-ms-green"
        ></span>
      </span>
      v1.0.0 Disponible Ahora
    </div>

    <h1
      class="mb-6 text-5xl font-extrabold tracking-tight leading-none md:text-6xl lg:text-7xl text-white"
    >
      Tu puerta de entrada al <br />
      <span class="text-gradient">Multiverso Minecraft</span>
    </h1>
    <p
      class="mb-10 text-lg font-normal text-gray-400 lg:text-xl sm:px-16 lg:px-48 max-w-4xl mx-auto"
    >
      Descubre, instala y gestiona tus modpacks favoritos con una experiencia <span
        class="text-white font-medium">moderna</span
      >, <span class="text-white font-medium">rápida</span> y <span
        class="text-white font-medium">segura</span
      >.
    </p>

    <div
      class="flex flex-col space-y-4 sm:flex-row sm:justify-center sm:space-y-0 sm:space-x-4"
    >
      <a
        href="#download"
        class="inline-flex justify-center items-center py-4 px-8 text-base font-bold text-center text-white rounded-xl bg-ms-green hover:bg-green-500 focus:ring-4 focus:ring-green-900 transition-all transform hover:scale-105 shadow-[0_0_20px_rgba(39,206,64,0.3)] hover:shadow-[0_0_30px_rgba(39,206,64,0.5)]"
      >
        Descargar Gratis
        <svg
          class="w-5 h-5 ms-2 -mr-1"
          fill="currentColor"
          viewBox="0 0 20 20"
          xmlns="http://www.w3.org/2000/svg"
          ><path
            fill-rule="evenodd"
            d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
            clip-rule="evenodd"></path></svg
        >
      </a>
      <a
        href="#features"
        class="inline-flex justify-center items-center py-4 px-8 text-base font-medium text-center text-white rounded-xl glass-panel hover:bg-white/5 focus:ring-4 focus:ring-gray-700 transition-all"
      >
        Explorar Características
      </a>
    </div>

    <!-- App Preview Mockup -->
    <div class="mt-20 relative mx-auto max-w-5xl">
      <div
        class="absolute -inset-1 bg-gradient-to-r from-ms-green to-blue-600 rounded-2xl blur opacity-20"
      >
      </div>
      <div
        class="relative rounded-xl border border-white/10 bg-background/50 backdrop-blur-xl shadow-2xl overflow-hidden"
      >
        <div
          class="flex items-center px-4 py-3 border-b border-white/5 bg-white/5"
        >
          <div class="flex space-x-2">
            <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
          </div>
          <div class="mx-auto text-xs text-gray-500 font-mono">
            Modpack Store
          </div>
        </div>
        <div
          class="aspect-video bg-card/50 flex items-center justify-center relative overflow-hidden group"
        >
          <!-- Placeholder for App Screenshot -->
          <div
            class="absolute inset-0 bg-gradient-to-br from-card to-background opacity-50"
          >
          </div>
          <span
            class="relative z-10 text-gray-500 font-mono text-sm border border-white/10 px-4 py-2 rounded glass-panel"
          >
            [Captura de Pantalla de la App]
          </span>

          <!-- Reflection effect -->
          <div
            class="absolute inset-0 bg-gradient-to-tr from-white/0 via-white/5 to-white/0 opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none transform translate-x-[-100%] group-hover:translate-x-[100%] transition-transform"
          >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
