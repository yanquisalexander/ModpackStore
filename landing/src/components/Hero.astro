---
import { Download } from "lucide-preact";

interface ReleasePlatform {
  browser_download_url?: string;
  url?: string;
}
interface ReleaseData {
  version: string;
  notes: string;
  pub_date: string;
  platforms: Record<string, ReleasePlatform>;
}
const release = Astro.props.release as ReleaseData | undefined;
const releaseVersion = release?.version ?? "canary";
---

<section class="relative overflow-hidden">
  <!-- Pixel-art flotante de fondo -->
  <svg
    class="absolute inset-0 w-full h-full pointer-events-none"
    aria-hidden="true"
    preserveAspectRatio="xMidYMid slice"
    viewBox="0 0 1200 700"
  >
    <g class="animate-floaty" style="transform-origin:150px 140px"
      ><rect
        x="90"
        y="90"
        width="110"
        height="110"
        rx="30"
        fill="#2f3a96"
        opacity=".7"></rect></g
    >
    <g
      class="animate-float-slow"
      style="transform-origin:1050px 150px"
      shape-rendering="crispEdges"
      ><rect x="1010" y="110" width="80" height="80" fill="#7a5638"></rect><rect
        x="1010"
        y="110"
        width="80"
        height="24"
        fill="#5fbf63"></rect><rect
        x="1010"
        y="134"
        width="16"
        height="10"
        fill="#5fbf63"></rect><rect
        x="1050"
        y="134"
        width="24"
        height="10"
        fill="#5fbf63"></rect><rect
        x="1030"
        y="160"
        width="10"
        height="10"
        fill="#5e422a"></rect><rect
        x="1066"
        y="170"
        width="10"
        height="10"
        fill="#5e422a"></rect></g
    >
    <g
      class="animate-floaty"
      style="transform-origin:1000px 510px"
      shape-rendering="crispEdges"
      fill="#ffb0d0"
      ><rect x="976" y="480" width="24" height="12"></rect><rect
        x="1012"
        y="480"
        width="24"
        height="12"></rect><rect x="964" y="492" width="84" height="24"
      ></rect><rect x="976" y="516" width="60" height="12"></rect><rect
        x="988"
        y="528"
        width="36"
        height="12"></rect><rect x="1000" y="540" width="12" height="12"
      ></rect></g
    >
    <g class="animate-floaty" style="transform-origin:200px 560px"
      ><path d="M200 510l50 85h-100z" fill="#f2c97d" opacity=".85"></path></g
    >
    <g class="animate-spin-slow" style="transform-origin:600px 90px"
      ><rect x="570" y="60" width="60" height="60" rx="14" fill="#3a3c42"
      ></rect></g
    >
  </svg>

  <div class="relative max-w-4xl mx-auto text-center px-5 pt-24 pb-36">
    <span
      id="hero-badge"
      class="px inline-block bg-s3 text-primary text-sm px-4 py-1.5 mb-6 border-b-4 border-s4"
    >
      Launcher oficial de SaltoCraft Extremo IV
    </span>
    <h1
      id="hero-title"
      class="text-4xl sm:text-6xl font-extrabold leading-tight tracking-tight text-text"
    >
      Ideal para tu <span class="inline-block text-primary"
        >evento<span class="wave-u"></span></span
      > o <span class="inline-block text-green"
        >server<span class="wave-u wave-g"></span></span
      >
    </h1>
    <p
      id="hero-desc"
      class="text-muted text-lg sm:text-xl mt-7 max-w-2xl mx-auto"
    >
      Crea y gestiona instancias de modpacks en un clic. También funciona como
      launcher de Minecraft normal.
      <span class="block mt-2 text-sm text-muted/80" data-live-notes
        >{release?.notes ?? ""}</span
      >
    </p>
    <div id="hero-cta" class="flex flex-wrap gap-3 justify-center mt-10">
      <a
        href="#descargar"
        class="btn-pixel inline-flex items-center gap-2 bg-primary text-on-primary font-bold rounded-full px-8 py-3.5 text-lg hover:brightness-110 transition"
      >
        <Download size={19} />
        Descargar gratis
      </a>
      <a
        href="#creadores"
        class="btn-pixel inline-flex items-center bg-s3 text-text font-bold rounded-full px-8 py-3.5 text-lg hover:bg-s4 transition"
      >
        Soy creador
      </a>
    </div>
    <div
      id="hero-meta"
      class="mt-8 flex flex-wrap justify-center gap-2 text-xs text-muted"
    >
      <span class="bg-s2 border border-s3 rounded-full px-3 py-1"
        >Windows · macOS · Linux</span
      >
      <span class="bg-s2 border border-s3 rounded-full px-3 py-1"
        >Forge · Fabric · NeoForge · Quilt</span
      >
      <span class="bg-s2 border border-s3 rounded-full px-3 py-1"
        >Instancias aisladas</span
      >
    </div>
  </div>
  <svg
    class="absolute bottom-0 w-full block"
    viewBox="0 0 1440 90"
    preserveAspectRatio="none"
    height="70"
    aria-hidden="true"
    ><path d="M0 40C240 100 480 0 720 40S1200 90 1440 30V90H0Z" fill="#232428"
    ></path></svg
  >
</section>

<script>
  import { gsap } from "gsap";
  const tl = gsap.timeline({ defaults: { ease: "power3.out" } });
  tl.from("#hero-badge", { opacity: 0, y: 16, duration: 0.6 })
    .from("#hero-title", { opacity: 0, y: 24, duration: 0.8 }, "-=0.3")
    .from("#hero-desc", { opacity: 0, y: 20, duration: 0.7 }, "-=0.5")
    .from("#hero-cta", { opacity: 0, y: 16, duration: 0.6 }, "-=0.4")
    .from("#hero-meta", { opacity: 0, y: 12, duration: 0.5 }, "-=0.4");
</script>
