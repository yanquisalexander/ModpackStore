---
import { Download, Monitor } from "lucide-preact";

interface ResolvedAsset { browser_download_url: string; }
interface ResolvedRelease {
  version: string;
  notes: string;
  pub_date: string;
  platforms: Record<string, ResolvedAsset>;
}
interface Props { release: ResolvedRelease; }
const { release } = Astro.props;

const downloadDefinitions = [
  { key: "windows-x86_64-msi", label: "Windows", short: "Win", icon: "windows" },
  { key: "linux-x86_64-appimage", label: "Linux (AppImage)", short: "Linux", icon: "linux" },
  { key: "linux-x86_64-deb", label: "Ubuntu / Debian", short: ".deb", icon: "linux" },
  { key: "linux-x86_64-rpm", label: "Fedora", short: ".rpm", icon: "linux" },
  { key: "darwin-aarch64", label: "macOS (Apple Silicon)", short: "Silicon", icon: "macos" },
  { key: "darwin-x86_64", label: "macOS (Intel)", short: "Intel", icon: "macos" },
];

const downloads = downloadDefinitions
  .map((entry) => {
    const asset = release.platforms?.[entry.key];
    if (!asset?.browser_download_url) return null;
    return { ...entry, url: asset.browser_download_url };
  })
  .filter((x): x is NonNullable<typeof x> => Boolean(x));

const publishedDate = new Intl.DateTimeFormat("es-ES", { dateStyle: "medium", timeStyle: "short" }).format(new Date(release.pub_date));
---

<section id="descargar" class="bg-bg px-5 pb-24 scroll-mt-20">
  <div id="download-card" class="cta-pixel relative overflow-hidden max-w-5xl mx-auto bg-pc rounded-[40px] px-6 py-14 sm:px-12 text-center">
    <div class="absolute -left-16 -top-16 w-56 h-56 bg-primary/20 animate-blob" aria-hidden="true"></div>
    <div class="absolute -right-12 -bottom-16 w-64 h-64 bg-green/20 animate-blob" aria-hidden="true"></div>

    <p class="px relative inline-block bg-black/25 text-primary text-xs rounded-none px-4 py-1.5 mb-5 border-b-4 border-black/30">
      CANARY <span data-live-version>{release.version}</span> · <span data-live-date>{publishedDate}</span>
    </p>
    <h2 class="relative text-3xl sm:text-4xl font-extrabold text-white">Empieza hoy, gratis</h2>
    <p class="relative text-primary/90 mt-3 max-w-xl mx-auto">App de escritorio para PC. Pruébalo como jugador o como creador. <span class="block mt-1 text-sm opacity-80" data-live-notes>{release.notes}</span></p>

    {downloads.length > 0 && (
      <a
        href={downloads[0].url}
        id="primary-download-btn"
        data-url={downloads[0].url}
        data-key={downloads[0].key}
        class="btn-pixel relative inline-flex items-center gap-2 mt-8 bg-primary text-on-primary font-bold rounded-full px-9 py-3.5 text-lg hover:brightness-110 transition"
      >
        <Download size={19} />
        <span id="primary-download-label">Descargar para {downloads[0].label}</span>
      </a>
    )}

    <div class="relative mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 text-left">
      {downloads.map((d) => (
        <a
          href={d.url}
          target="_blank"
          rel="noopener noreferrer"
          data-platform={d.key}
          class="download-card group bg-black/25 hover:bg-black/35 border border-white/10 hover:border-white/25 rounded-[20px] p-4 flex items-center gap-3 transition-all"
        >
          <div class="size-10 rounded-xl bg-white/10 border border-white/10 grid place-items-center text-white shrink-0">
            {d.icon === "windows" ? (
              <svg class="size-5" viewBox="0 0 24 24" fill="currentColor"><path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801" /></svg>
            ) : d.icon === "macos" ? (
              <svg class="size-5" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z" /></svg>
            ) : (
              <Monitor size={18} />
            )}
          </div>
          <div class="min-w-0 flex-1">
            <div class="text-sm font-bold text-white truncate">{d.label}</div>
            <div class="text-[11px] text-white/60">64-bit · {d.short}</div>
          </div>
          <Download size={15} class="text-white/60 group-hover:text-white group-hover:translate-y-0.5 transition-all shrink-0" />
        </a>
      ))}
      {downloads.length === 0 && (
        <div class="rounded-2xl border border-dashed border-white/20 p-4 text-sm text-white/70 sm:col-span-2 lg:col-span-3 text-center">
          No hay descargas disponibles en este momento.
        </div>
      )}
    </div>

    <p class="relative mt-6 text-[11px] text-white/50">Windows 10/11 · macOS · Ubuntu · Debian · Fedora — Detección automática de tu sistema</p>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);
  gsap.from("#download-card", {
    scrollTrigger: { trigger: "#download-card", start: "top 85%" },
    opacity: 0, y: 50, duration: 1, ease: "power3.out",
  });

  function detectPlatform(): string | null {
    const ua = navigator.userAgent.toLowerCase();
    if (ua.includes("win")) return "windows-x86_64-msi";
    if (ua.includes("mac")) {
      const isAppleSilicon = ua.includes("arm") || ua.includes("aarch64");
      return isAppleSilicon ? "darwin-aarch64" : "darwin-x86_64";
    }
    if (ua.includes("linux")) return "linux-x86_64-appimage";
    return null;
  }
  function getPlatformLabel(key: string): string {
    const labels: Record<string, string> = {
      "windows-x86_64-msi": "Windows",
      "linux-x86_64-appimage": "Linux (AppImage)",
      "linux-x86_64-deb": "Ubuntu / Debian",
      "linux-x86_64-rpm": "Fedora",
      "darwin-aarch64": "macOS (Apple Silicon)",
      "darwin-x86_64": "macOS (Intel)",
    };
    return labels[key] ?? key;
  }
  function initPlatformDetection() {
    const platform = detectPlatform();
    if (!platform) return;
    const primaryBtn = document.getElementById("primary-download-btn") as HTMLAnchorElement | null;
    const primaryLabel = document.getElementById("primary-download-label");
    if (!primaryBtn || !primaryLabel) return;
    const matchingCard = document.querySelector(`[data-platform="${platform}"]`) as HTMLAnchorElement | null;
    if (!matchingCard) return;
    primaryBtn.setAttribute("href", matchingCard.href);
    primaryLabel.textContent = `Descargar para ${getPlatformLabel(platform)}`;
    matchingCard.classList.add("ring-2", "ring-white/40");
    const grid = matchingCard.parentElement;
    if (grid) grid.prepend(matchingCard);
  }
  document.addEventListener("astro:page-load", initPlatformDetection);
  if (document.readyState === "complete" || document.readyState === "interactive") initPlatformDetection();
  else document.addEventListener("DOMContentLoaded", initPlatformDetection);
</script>
