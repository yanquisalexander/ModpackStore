---
import { Menu, X, Download } from "lucide-preact";

const links = [
  { label: "Jugadores", url: "/#jugadores" },
  { label: "Creadores", url: "/#creadores" },
  { label: "Guía", url: "/guias/como-instalar-modpacks-minecraft/" },
  { label: "FAQ", url: "/preguntas-frecuentes/" },
  { label: "Descargar", url: "/#descargar" },
];
---

<header id="site-header" class="sticky top-0 z-30 bg-bg/90 backdrop-blur border-b border-s3">
  <nav class="max-w-6xl mx-auto flex items-center justify-between px-5 h-16">
    <a href="/#" class="flex items-center gap-2 font-extrabold text-lg text-text">
      <span class="grid place-items-center w-[30px] h-[30px] rounded-[9px] bg-primary overflow-hidden shrink-0">
        <img src="/icon.png" alt="ModpackStore logo" width="30" height="30" class="w-[26px] h-[26px] object-contain" />
      </span>
      Modpack Store
    </a>
    <div class="hidden md:flex gap-7 text-muted font-medium">
      {links.slice(0, 4).map((l) => (
        <a href={l.url} class="hover:text-text transition-colors">{l.label}</a>
      ))}
    </div>
    <div class="flex items-center gap-2">
      <a href="/#descargar" class="btn-pixel hidden sm:inline-flex bg-primary text-on-primary font-bold rounded-full px-5 py-2 hover:brightness-110 transition items-center gap-1.5">
        <Download size={15} />
        Descargar
      </a>
      <button id="mobile-menu-btn" class="md:hidden p-2 text-muted hover:text-text bg-s3 hover:bg-s4 rounded-full transition-all" aria-label="Menú">
        <Menu size={18} />
      </button>
    </div>
  </nav>
</header>

<div id="mobile-drawer" class="fixed inset-0 z-[60] hidden pointer-events-none">
  <div id="drawer-bg" class="absolute inset-0 bg-black/70 backdrop-blur-sm opacity-0 transition-opacity duration-300 pointer-events-auto"></div>
  <nav id="drawer-panel" class="absolute top-0 right-0 h-full w-[85%] max-w-sm bg-s1 border-l border-s3 shadow-2xl transform translate-x-full transition-transform duration-300 ease-out pointer-events-auto flex flex-col p-6">
    <div class="flex justify-between items-center mb-6 pb-4 border-b border-s3">
      <div class="flex items-center gap-2 font-extrabold text-text">
        <span class="grid place-items-center w-[26px] h-[26px] rounded-[8px] bg-primary overflow-hidden shrink-0">
          <img src="/icon.png" alt="ModpackStore logo" width="26" height="26" class="w-[22px] h-[22px] object-contain" />
        </span>
        Modpack Store
      </div>
      <button id="close-drawer" class="text-muted hover:text-text p-1.5 hover:bg-s3 rounded-full transition-colors" aria-label="Cerrar">
        <X size={20} />
      </button>
    </div>
    <div class="flex-1 overflow-y-auto space-y-1.5">
      {links.map((l) => (
        <a href={l.url} class="flex items-center gap-3 px-4 py-3 rounded-2xl text-sm font-medium text-text bg-s2 hover:bg-s3 border border-transparent hover:border-s4 transition-all">
          {l.label}
        </a>
      ))}
    </div>
    <div class="pt-6 border-t border-s3">
      <a href="/#descargar" class="btn-pixel flex items-center justify-center gap-2 w-full px-4 py-3 bg-primary text-on-primary font-bold text-sm rounded-2xl hover:brightness-110 transition-all">
        <Download size={16} />
        Descargar Launcher
      </a>
    </div>
  </nav>
</div>

<script>
  function initNav() {
    const mobileBtn = document.getElementById("mobile-menu-btn");
    const closeBtn = document.getElementById("close-drawer");
    const drawer = document.getElementById("mobile-drawer");
    const drawerBg = document.getElementById("drawer-bg");
    const drawerPanel = document.getElementById("drawer-panel");

    const openMenu = () => {
      drawer?.classList.remove("hidden");
      setTimeout(() => {
        drawerBg?.classList.remove("opacity-0");
        drawerPanel?.classList.remove("translate-x-full");
      }, 10);
      document.body.style.overflow = "hidden";
    };
    const closeMenu = () => {
      drawerBg?.classList.add("opacity-0");
      drawerPanel?.classList.add("translate-x-full");
      setTimeout(() => {
        drawer?.classList.add("hidden");
        document.body.style.overflow = "";
      }, 300);
    };
    mobileBtn?.addEventListener("click", openMenu);
    closeBtn?.addEventListener("click", closeMenu);
    drawerBg?.addEventListener("click", closeMenu);
    drawerPanel?.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeMenu));

    // Smooth anchor con scroll-padding ya en CSS; cierre limpio
    document.querySelectorAll<HTMLAnchorElement>('a[href^="/#"]').forEach((anchor) => {
      anchor.addEventListener("click", (e) => {
        const href = anchor.getAttribute("href");
        if (!href) return;
        const hash = href.slice(1); // "#jugadores"
        if (hash.startsWith("#")) {
          const target = document.querySelector(hash);
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: "smooth" });
            history.pushState(null, "", hash);
          }
        }
      });
    });
  }
  document.addEventListener("astro:page-load", initNav);
  if (document.readyState === "complete" || document.readyState === "interactive") initNav();
  else document.addEventListener("DOMContentLoaded", initNav);
</script>
