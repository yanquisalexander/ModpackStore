---
import {
  Menu,
  X,
  Download,
  Home,
  Sparkles,
  Users,
  HelpCircle,
} from "lucide-preact";

const links = [
  { label: "Inicio", url: "/", icon: Home },
  { label: "Características", url: "#features", icon: Sparkles },
  { label: "Creadores", url: "#creators", icon: Users },
  { label: "FAQ", url: "#faq", icon: HelpCircle },
];

const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 w-full py-6 transition-all duration-500 opacity-0 -translate-y-10"
>
  <div
    id="nav-island"
    class="relative mx-auto flex items-center justify-between px-2 py-2 pr-2 md:px-6 md:py-3 transition-all duration-500 ease-out w-[95%] max-w-6xl rounded-full border border-white/10 bg-black/20 backdrop-blur-xl backdrop-saturate-150 shadow-[0_8px_32px_0_rgba(0,0,0,0.36),inset_0_0_0_1px_rgba(255,255,255,0.05)]"
  >
    <div
      class="absolute inset-x-4 top-0 h-px bg-gradient-to-r from-transparent via-white/30 to-transparent opacity-70"
    >
    </div>
    <div
      class="absolute inset-x-10 bottom-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent opacity-50"
    >
    </div>

    <div class="relative z-10 flex items-center gap-4 pl-2">
      <a
        href="/"
        class="flex items-center gap-3 group transition-transform hover:scale-105"
      >
        <div class="relative w-10 h-10 flex items-center justify-center">
          <div
            class="absolute inset-0 bg-ms-primary blur-[20px] opacity-20 group-hover:opacity-50 transition-opacity duration-500 rounded-full"
          >
          </div>
          <img
            src="/icon.png"
            class="relative w-8 h-8 rounded-lg shadow-lg"
            alt="Logo"
          />
        </div>
        <span
          class="hidden md:block font-lexend font-bold text-lg tracking-tight text-white drop-shadow-md"
        >
          Modpack<span class="text-ms-primary">Store</span>
        </span>
      </a>
    </div>

    <nav
      class="hidden md:flex items-center gap-1 absolute left-1/2 -translate-x-1/2"
    >
      {
        links.map((link) => {
          const isActive = currentPath === link.url;
          return (
            <a
              href={link.url}
              class="relative px-5 py-2 group rounded-full transition-all duration-300 overflow-hidden"
            >
              {/* Fondo Hover Sutil */}
              <div class="absolute inset-0 bg-white/0 group-hover:bg-white/5 transition-colors duration-300 rounded-full" />

              {/* Texto */}
              <span
                class={`relative z-10 text-sm font-medium tracking-wide transition-colors duration-300 flex items-center gap-2 ${
                  isActive
                    ? "text-white drop-shadow-[0_0_10px_rgba(255,255,255,0.5)]"
                    : "text-neutral-400 group-hover:text-white"
                }`}
              >
                {isActive && (
                  <span class="w-1.5 h-1.5 rounded-full bg-ms-primary shadow-[0_0_10px_currentColor]" />
                )}
                {link.label}
              </span>

              {/* Luz activa inferior (Laser style) */}
              <span
                class={`absolute bottom-0 left-1/2 -translate-x-1/2 h-[2px] bg-gradient-to-r from-transparent via-ms-primary to-transparent rounded-full blur-[1px] transition-all duration-500 ease-out ${
                  isActive
                    ? "w-3/4 opacity-100 shadow-[0_0_15px_rgba(99,102,241,0.8)]"
                    : "w-0 opacity-0 group-hover:w-1/2 group-hover:opacity-50"
                }`}
              />
            </a>
          );
        })
      }
    </nav>

    <div class="relative z-10 flex items-center gap-3">
      <a
        href="#download"
        class="hidden md:flex relative items-center gap-2 px-6 py-2.5 rounded-full font-bold text-sm text-white overflow-hidden group transition-all hover:scale-105 active:scale-95 shadow-[0_10px_20px_-10px_rgba(99,102,241,0.5)]"
      >
        <div
          class="absolute inset-0 bg-ms-primary transition-colors group-hover:bg-ms-primary-light"
        >
        </div>

        <div
          class="absolute inset-0 bg-gradient-to-b from-white/20 to-transparent pointer-events-none"
        >
        </div>
        <div
          class="absolute inset-0 shadow-[inset_0_1px_1px_rgba(255,255,255,0.4),inset_0_-2px_4px_rgba(0,0,0,0.2)] rounded-full pointer-events-none"
        >
        </div>

        <Download size={16} class="relative z-10" />
        <span class="relative z-10">Descargar</span>
      </a>

      <button
        id="mobile-menu-btn"
        class="md:hidden p-3 text-neutral-300 hover:text-white bg-white/5 hover:bg-white/10 border border-white/5 rounded-full transition-all backdrop-blur-md shadow-inner"
        aria-label="Menu"
      >
        <Menu size={20} />
      </button>
    </div>
  </div>
</header>

<div id="mobile-drawer" class="fixed inset-0 z-[60] hidden pointer-events-none">
  <div
    id="drawer-bg"
    class="absolute inset-0 bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-300 pointer-events-auto"
  >
  </div>

  <nav
    id="drawer-panel"
    class="absolute top-0 right-0 h-full w-[85%] max-w-sm bg-[#050505]/90 backdrop-blur-2xl border-l border-white/10 shadow-[0_0_50px_rgba(0,0,0,0.5)] transform translate-x-full transition-transform duration-500 ease-[cubic-bezier(0.32,0.725,0,1)] pointer-events-auto flex flex-col"
  >
    <div
      class="absolute inset-0 opacity-[0.03] bg-[url('https://grainy-gradients.vercel.app/noise.svg')] pointer-events-none"
    >
    </div>

    <div
      class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-white/20 to-transparent"
    >
    </div>

    <div class="relative px-6 py-8 flex justify-between items-center mb-4">
      <span
        class="font-lexend font-bold text-xl text-white tracking-tight flex items-center gap-2"
      >
        <div
          class="w-2 h-2 rounded-full bg-ms-primary shadow-[0_0_10px_currentColor]"
        >
        </div>
        Navegación
      </span>
      <button
        id="close-drawer"
        class="text-neutral-400 hover:text-white p-2 hover:bg-white/10 rounded-full transition-colors"
      >
        <X size={24} />
      </button>
    </div>

    <div class="relative flex-1 overflow-y-auto px-4 space-y-2">
      {
        links.map((link) => (
          <a
            href={link.url}
            class={`flex items-center gap-4 px-4 py-4 rounded-2xl font-medium text-lg transition-all border border-transparent ${
              currentPath === link.url
                ? "bg-ms-primary/10 text-ms-primary border-ms-primary/20 shadow-[0_0_20px_rgba(99,102,241,0.1)]"
                : "text-neutral-400 hover:bg-white/5 hover:text-white hover:border-white/5"
            }`}
          >
            <link.icon size={22} strokeWidth={1.5} />
            {link.label}
          </a>
        ))
      }

      <div class="mt-8 pt-8 border-t border-white/10 px-2">
        <a
          href="#download"
          class="flex items-center justify-center gap-2 w-full px-5 py-4 bg-ms-primary text-white font-bold rounded-xl transition-all shadow-lg hover:shadow-ms-primary/30 hover:scale-[1.02] active:scale-[0.98]"
        >
          <Download size={20} />
          Descargar App
        </a>
      </div>
    </div>
  </nav>
</div>

<script>
  import { gsap } from "gsap";

  // Inicialización y Animaciones
  document.addEventListener("astro:page-load", () => {
    initHeader();
  });

  // Fallback para primera carga si no usas ViewTransitions
  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    initHeader();
  } else {
    document.addEventListener("DOMContentLoaded", initHeader);
  }

  function initHeader() {
    const header = document.getElementById("site-header");
    const navIsland = document.getElementById("nav-island");
    const mobileBtn = document.getElementById("mobile-menu-btn");
    const closeBtn = document.getElementById("close-drawer");
    const drawer = document.getElementById("mobile-drawer");
    const drawerBg = document.getElementById("drawer-bg");
    const drawerPanel = document.getElementById("drawer-panel");

    if (!header) return;

    // 1. Animación de Entrada (GSAP)
    gsap.to(header, {
      opacity: 1,
      y: 0,
      duration: 1.2,
      delay: 0.2,
      ease: "power4.out",
    });

    // 2. Lógica de Scroll (Liquid Transform)
    const handleScroll = () => {
      const isScrolled = window.scrollY > 20;

      if (isScrolled) {
        // Estado Scrolleado: Más compacto, más oscuro/sólido
        navIsland?.classList.remove("w-[95%]", "md:py-3", "bg-black/20");
        navIsland?.classList.add(
          "w-[90%]",
          "md:py-2",
          "bg-black/60",
          "shadow-[0_10px_40px_-10px_rgba(0,0,0,0.5)]",
        );
      } else {
        // Estado Inicial: Más ancho, más transparente
        navIsland?.classList.add("w-[95%]", "md:py-3", "bg-black/20");
        navIsland?.classList.remove(
          "w-[90%]",
          "md:py-2",
          "bg-black/60",
          "shadow-[0_10px_40px_-10px_rgba(0,0,0,0.5)]",
        );
      }
    };

    window.addEventListener("scroll", handleScroll, { passive: true });
    // Ejecutar una vez al inicio
    handleScroll();

    // 3. Menú Móvil
    const openMenu = () => {
      drawer?.classList.remove("hidden");
      setTimeout(() => {
        drawerBg?.classList.remove("opacity-0");
        drawerPanel?.classList.remove("translate-x-full");
      }, 10);
      document.body.style.overflow = "hidden";
    };

    const closeMenu = () => {
      drawerBg?.classList.add("opacity-0");
      drawerPanel?.classList.add("translate-x-full");
      setTimeout(() => {
        drawer?.classList.add("hidden");
        document.body.style.overflow = "";
      }, 500);
    };

    mobileBtn?.addEventListener("click", openMenu);
    closeBtn?.addEventListener("click", closeMenu);
    drawerBg?.addEventListener("click", closeMenu);

    // Cerrar al clickear enlaces
    drawerPanel?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });
  }
</script>
