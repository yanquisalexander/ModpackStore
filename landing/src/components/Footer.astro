---
const year = new Date().getFullYear();
---

<footer class="bg-s1 px-5 py-10 text-sm text-muted">
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-wrap gap-4 justify-between items-center">
      <a href="/#" class="flex items-center gap-2 font-extrabold text-text">
        <span class="grid place-items-center w-[24px] h-[24px] rounded-[7px] bg-primary overflow-hidden shrink-0">
          <img src="/icon.png" alt="ModpackStore logo" width="24" height="24" class="w-[20px] h-[20px] object-contain" />
        </span>
        Modpack Store
      </a>
      <nav class="flex flex-wrap gap-x-5 gap-y-2 text-xs">
        <a href="/guias/como-instalar-modpacks-minecraft/" class="hover:text-text transition-colors">Guía de instalación</a>
        <a href="/preguntas-frecuentes/" class="hover:text-text transition-colors">FAQ</a>
        <a href="/sobre-nosotros/" class="hover:text-text transition-colors">Nosotros</a>
        <a href="/contacto/" class="hover:text-text transition-colors">Contacto</a>
        <a href="https://discord.gg/9upQuDS4YQ" target="_blank" rel="noopener noreferrer" class="hover:text-text transition-colors">Discord</a>
      </nav>
    </div>
    <div class="mt-6 pt-6 border-t border-s3 flex flex-wrap gap-4 justify-between items-center text-xs text-muted/80">
      <p>© {year} Modpack Store. No afiliado a Mojang ni Microsoft. Desarrollado por <a href="https://alexitoo.dev" target="_blank" rel="noopener noreferrer" class="hover:text-text underline underline-offset-2">alexitoo.dev</a></p>
      <div class="flex gap-5">
        <a href="/privacidad/" class="hover:text-text transition-colors">Privacidad</a>
        <a href="/terminos/" class="hover:text-text transition-colors">Términos</a>
        <a href="/cookies/" class="hover:text-text transition-colors">Cookies</a>
        <a href="/aviso-legal-minecraft/" class="hover:text-text transition-colors">Aviso legal</a>
      </div>
    </div>
  </div>
</footer>
