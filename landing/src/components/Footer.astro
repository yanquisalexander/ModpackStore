---

---

<footer
  class="bg-card/30 border-t border-white/5 py-16 backdrop-blur-lg relative overflow-hidden"
>
  <!-- Glow effect -->
  <div
    class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[800px] h-[300px] bg-ms-green/5 rounded-full blur-[100px] pointer-events-none"
  >
  </div>

  <div class="max-w-screen-xl mx-auto px-4 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
      <div class="col-span-1 md:col-span-2">
        <span
          class="text-2xl font-semibold text-white mb-6 block tracking-tight"
          >Modpack<span class="text-ms-green">Store</span></span
        >
        <p class="text-gray-400 mb-6 max-w-sm leading-relaxed">
          La plataforma definitiva para descubrir, crear y jugar modpacks de
          Minecraft. Hecho por la comunidad, para la comunidad.
        </p>
        <div class="flex space-x-4">
          <!-- Social Links placeholders -->
          <a
            href="#"
            class="w-10 h-10 rounded-full glass-panel flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/10 transition-all"
          >
            <span class="sr-only">Twitter</span>
            <svg
              class="w-5 h-5"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
              ><path
                d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"
              ></path></svg
            >
          </a>
          <a
            href="#"
            class="w-10 h-10 rounded-full glass-panel flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/10 transition-all"
          >
            <span class="sr-only">Discord</span>
            <svg
              class="w-5 h-5"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
              ><path
                fill-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.526.095.715-.23.715-.504 0-.247-.009-.902-.013-1.77-2.782.605-3.369-1.343-3.369-1.343-.479-1.218-1.17-1.542-1.17-1.542-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                clip-rule="evenodd"></path></svg
            >
          </a>
        </div>
      </div>

      <div>
        <h3 class="text-white font-semibold mb-6">Producto</h3>
        <ul class="space-y-3">
          <li>
            <a
              href="#"
              class="text-gray-400 hover:text-ms-green transition-colors"
              >Descargar</a>
          </li>
          <li>
            <a
              href="#"
              class="text-gray-400 hover:text-ms-green transition-colors"
              >Características</a>
          </li>
          <li>
            <a
              href="#"
              class="text-gray-400 hover:text-ms-green transition-colors"
              >Changelog</a>
          </li>
          <li>
            <a
              href="#"
              class="text-gray-400 hover:text-ms-green transition-colors"
              >Roadmap</a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-white font-semibold mb-6">Legal</h3>
        <ul class="space-y-3">
          <li>
            <a
              href="#"
              class="text-gray-400 hover:text-ms-green transition-colors"
              >Términos de Servicio</a>
          </li>
          <li>
            <a
              href="#"
              class="text-gray-400 hover:text-ms-green transition-colors"
              >Política de Privacidad</a>
          </li>
          <li>
            <a
              href="#"
              class="text-gray-400 hover:text-ms-green transition-colors"
              >DMCA</a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="border-t border-white/5 mt-16 pt-8 text-center text-gray-500 text-sm"
    >
      <p>
        &copy; {new Date().getFullYear()} Modpack Store. No afiliado con Mojang Studios.
      </p>
    </div>
  </div>
</footer>
