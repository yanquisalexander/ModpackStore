---
// src/components/Footer.astro
const year = new Date().getFullYear();
---

<footer
  class="relative z-10 w-full border-t border-white/5 bg-[#0a0a0a] pt-16 pb-8"
>
  <div class="max-w-7xl mx-auto px-4 flex flex-col items-center text-center">
    <div class="mb-6 flex flex-col items-center gap-2">
      <img src="/icon.png" class="h-10 w-10 rounded-xl mb-2" alt="Logo" />
      <span class="text-2xl font-lexend font-bold text-white tracking-tight">
        Modpack<span class="text-ms-primary">Store</span>
      </span>
    </div>

    <nav
      class="flex flex-wrap justify-center gap-x-8 gap-y-4 mb-8 text-sm font-medium text-neutral-400"
    >
      <a href="#" class="hover:text-ms-primary transition-colors">Descargar</a>
      <a href="#" class="hover:text-ms-primary transition-colors"
        >Características</a
      >
      <a href="#" class="hover:text-ms-primary transition-colors">Términos</a>
      <a href="#" class="hover:text-ms-primary transition-colors">Privacidad</a>
    </nav>

    <div class="flex gap-4 mb-10">
      <a
        href="https://discord.gg/9upQuDS4YQ"
        target="_blank"
        class="p-2 text-neutral-500 hover:text-white hover:bg-white/5 rounded-lg transition-all"
        aria-label="Discord"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
          ><path
            d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028 14.09 14.09 0 001.226-1.994.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"
          ></path></svg
        >
      </a>
    </div>

    <div class="flex flex-col items-center gap-4 mb-12">
      <div class="flex flex-col items-center gap-2 group">
        <span
          class="text-[10px] uppercase tracking-[0.2em] text-neutral-600 font-bold"
          >Un producto de</span
        >
        <a
          href="https://alexitoo.dev"
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center gap-2"
        >
          <img
            src="data:image/webp;base64,"
            class="h-6 w-auto grayscale brightness-200 group-hover:grayscale-0 group-hover:brightness-100 transition-all duration-500"
            alt="Alexitoo.DEV Logo"
          />
          <span
            class="text-xs text-neutral-500 group-hover:text-white transition-colors font-medium"
            >alexitoo.dev</span
          >
        </a>
      </div>
    </div>

    <div class="text-xs text-neutral-600 font-mono">
      <p>&copy; {year} Modpack Store. No afiliado con Mojang Studios.</p>
    </div>
  </div>
</footer>
