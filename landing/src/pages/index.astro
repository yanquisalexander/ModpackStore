---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Modpack Store - Tu lanzador de Minecraft definitivo">
  <main>
    <Hero />
    <Features />

    <!-- Download Section -->
    <section id="download" class="py-32 relative overflow-hidden">
      <div class="absolute inset-0 bg-ms-green/5"></div>
      <div
        class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-ms-green/50 to-transparent"
      >
      </div>

      <div class="max-w-screen-xl mx-auto px-4 relative z-10 text-center">
        <h2
          class="text-4xl md:text-6xl font-bold text-white mb-8 tracking-tight"
        >
          ¿Listo para empezar?
        </h2>
        <p
          class="text-xl text-gray-300 mb-12 max-w-2xl mx-auto leading-relaxed"
        >
          Descarga Modpack Store hoy y transforma tu experiencia de Minecraft.
          Disponible para Windows, macOS y Linux.
        </p>

        <div class="flex flex-col sm:flex-row justify-center gap-6">
          <button
            class="px-10 py-5 bg-ms-green hover:bg-green-500 text-white rounded-2xl font-bold text-lg transition-all transform hover:scale-105 flex items-center justify-center gap-3 shadow-[0_0_30px_rgba(39,206,64,0.4)] hover:shadow-[0_0_50px_rgba(39,206,64,0.6)]"
          >
            <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24"
              ><path d="M0 0h24v24H0z" fill="none"></path><path
                d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"></path></svg
            >
            Descargar para Windows
          </button>
          <button
            class="px-10 py-5 bg-card/50 hover:bg-card text-white border border-white/10 rounded-2xl font-bold text-lg transition-all flex items-center justify-center gap-3 backdrop-blur-md hover:border-white/20"
          >
            Otras Plataformas
          </button>
        </div>
        <p class="mt-6 text-sm text-gray-500 font-mono">
          Versión 1.0.0 • Windows 10/11 (64-bit)
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
