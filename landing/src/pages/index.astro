---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import Footer from "../components/Footer.astro";
import DownloadSection from "../components/DownloadSection.astro";
import TrustedCommunities from "@/components/TrustedCommunities.astro";
import LiveRelease from "@/components/LiveRelease.tsx";

interface ResolvedAsset { browser_download_url: string; }
interface ResolvedRelease {
  version: string;
  notes: string;
  pub_date: string;
  platforms: Record<string, ResolvedAsset>;
}

// Fallback estático: el crawler (AdSense) siempre ve contenido y descargas.
// LiveRelease (client-side) lo hidrata con la versión canary real de GitHub.
const RELEASES_PAGE = "https://github.com/ModpackStore/ModpackStore-Releases/releases";
const release: ResolvedRelease = {
  version: "canary",
  notes: "Launcher gratuito para modpacks de Minecraft en Windows, macOS y Linux",
  pub_date: "2026-01-15T00:00:00.000Z",
  platforms: {
    "windows-x86_64-msi": { browser_download_url: RELEASES_PAGE },
    "linux-x86_64-appimage": { browser_download_url: RELEASES_PAGE },
    "linux-x86_64-deb": { browser_download_url: RELEASES_PAGE },
    "linux-x86_64-rpm": { browser_download_url: RELEASES_PAGE },
    "darwin-aarch64": { browser_download_url: RELEASES_PAGE },
    "darwin-x86_64": { browser_download_url: RELEASES_PAGE },
  },
};

const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "ModpackStore",
  applicationCategory: "GameApplication",
  operatingSystem: "Windows, macOS, Linux",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description: "Launcher gratuito para instalar y gestionar modpacks de Minecraft con instancias aisladas y optimización automática.",
};
---

<Layout
  title="Modpack Store – El launcher de Minecraft para tu evento o server"
  description="Modpack Store es un launcher de Minecraft para crear y gestionar instancias de modpacks. Ideal para eventos, servidores y comunidades."
>
  <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
  <LiveRelease client:load />

  <main class="relative z-10">
    <Hero release={release} />
    <Features />

    <!-- TinyADZ inline ad -->
    <div class="bg-s1 px-5 pb-16">
      <div class="max-w-3xl mx-auto text-center">
        <div ta-ad-container=""></div>
      </div>
    </div>

    <TrustedCommunities />
    <DownloadSection release={release} />

    <!-- Texto editorial largo (señal de valor para AdSense) -->
    <section class="relative px-5 pb-20 bg-bg">
      <div class="mx-auto max-w-3xl bg-s2 rounded-[28px] p-6 sm:p-8">
        <h2 class="text-2xl font-extrabold text-text">Un launcher pensado para jugar, no para configurar</h2>
        <p class="mt-3 text-sm md:text-base text-muted leading-relaxed">
          Instalar mods manualmente implica combinar loader (Forge o Fabric), versión exacta de
          Minecraft, dependencias, versión de Java y memoria RAM. Un error y el juego no abre o
          pierdes tus mundos. ModpackStore encapsula todo eso en instancias aisladas: cada modpack
          vive en su propia carpeta con sus mundos y ajustes.
        </p>
        <p class="mt-3 text-sm md:text-base text-muted leading-relaxed">
          Además detecta tu hardware para elegir Java, argumentos JVM y RAM, algo clave en PCs
          modestos. Y si eres creador o administras un servidor, puedes publicar versiones con
          actualizaciones automáticas para tus jugadores en vez de repartir zips por Discord.
          Conoce al equipo en <a class="text-primary underline underline-offset-2 hover:brightness-110" href="/sobre-nosotros/">sobre nosotros</a>
          o escríbenos por <a class="text-primary underline underline-offset-2 hover:brightness-110" href="/contacto/">contacto</a>.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
