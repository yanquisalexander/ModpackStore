---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import Footer from "../components/Footer.astro";
import { DOWNLOAD_URL } from "@/consts";
---

<Layout title="Modpack Store - Gestiona tu universo Minecraft">
  <div class="fixed inset-0 z-[-1] bg-[#050505] pointer-events-none">
    <div
      class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-ms-primary/10 blur-[120px] rounded-full animate-pulse-slow"
    >
    </div>

    <div
      class="absolute bottom-0 right-1/4 w-[600px] h-[600px] bg-ms-secondary/10 blur-[120px] rounded-full animate-pulse-slow"
      style="animation-delay: 2s;"
    >
    </div>

    <div class="absolute inset-0 opacity-[0.02] mix-blend-overlay"></div>
  </div>

  <main class="relative z-10 flex flex-col gap-32 pt-10 pb-20">
    <Hero />

    <Features />

    <section id="download" class="px-4 relative">
      <div class="max-w-5xl mx-auto" id="download-container">
        <div
          id="download-card"
          class="relative group rounded-3xl p-[1px] bg-gradient-to-b from-white/10 via-white/5 to-transparent overflow-hidden opacity-0 translate-y-20"
        >
          <div class="absolute inset-0 bg-[#0a0a0a] rounded-3xl"></div>

          <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-3/4 h-3/4 bg-ms-primary/5 blur-[80px] rounded-full group-hover:bg-ms-primary/10 transition-all duration-1000"
          >
          </div>

          <div
            class="relative z-10 px-8 py-20 md:px-24 md:py-24 text-center flex flex-col items-center"
          >
            <div
              class="mb-8 p-4 rounded-2xl bg-ms-primary/10 border border-ms-primary/20 shadow-[0_0_30px_rgba(99,102,241,0.2)] animate-float"
            >
              <svg
                class="w-10 h-10 text-ms-primary"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                ></path>
              </svg>
            </div>

            <h2
              class="text-4xl md:text-6xl font-lexend font-bold text-white mb-6 tracking-tight"
            >
              Instala tu próxima <br />
              <span
                class="bg-clip-text text-transparent bg-gradient-to-b from-ms-primary-light to-ms-secondary"
              >
                aventura hoy.
              </span>
            </h2>

            <p
              class="text-lg text-neutral-400 mb-10 max-w-xl mx-auto leading-relaxed"
            >
              Compatible con Windows y Linux. <br />
              Gestiona instancias, importa modpacks y juega sin límites.
            </p>

            <div
              class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto"
            >
              <a
                href={DOWNLOAD_URL}
                target="_blank"
                class="w-full sm:w-auto px-8 py-4 bg-gradient-to-r from-ms-primary to-ms-primary-dark hover:from-ms-primary-light hover:to-ms-primary text-white rounded-xl font-bold text-lg transition-all shadow-lg shadow-ms-primary-dark/20 hover:shadow-ms-primary-dark/40 hover:-translate-y-0.5 flex items-center justify-center gap-2"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                  ></path></svg
                >
                Descargar Launcher
              </a>
            </div>

            <div
              class="mt-12 pt-8 border-t border-white/5 w-full max-w-sm mx-auto flex justify-between text-xs text-neutral-500 font-mono"
            >
              <span>v1.0.0 Stable</span>
              <span class="flex items-center gap-1 text-ms-primary/70">
                <span class="w-2 h-2 rounded-full bg-ms-primary animate-pulse"
                ></span>
                Online Services
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Download section animation
  gsap.to("#download-card", {
    scrollTrigger: {
      trigger: "#download-container",
      start: "top 85%",
    },
    opacity: 1,
    y: 0,
    duration: 1.2,
    ease: "power4.out",
  });
</script>
