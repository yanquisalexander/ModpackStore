---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import Footer from "../components/Footer.astro";
import DownloadSection from "../components/DownloadSection.astro";
import { CANARY_RELEASES_URL } from "@/consts";
import TrustedCommunities from "@/components/TrustedCommunities.astro";

interface TauriAsset {
  url?: string;
  signature?: string;
  browser_download_url?: string;
}

interface TauriManifest {
  version: string;
  notes: string;
  pub_date: string;
  platforms: Record<string, TauriAsset>;
}

interface ResolvedAsset {
  browser_download_url: string;
}

interface ResolvedRelease {
  version: string;
  notes: string;
  pub_date: string;
  platforms: Record<string, ResolvedAsset>;
}

const fallbackRelease: ResolvedRelease = {
  version: "canary",
  notes: "Última versión disponible",
  pub_date: new Date().toISOString(),
  platforms: {},
};

let release = fallbackRelease;

try {
  const response = await fetch(CANARY_RELEASES_URL, {
    headers: { accept: "application/json" },
  });

  if (response.ok) {
    const manifest = (await response.json()) as TauriManifest;

    const platformEntries = Object.entries(manifest.platforms);

    const resolvedPlatforms: Record<string, ResolvedAsset> = {};

    await Promise.all(
      platformEntries.map(async ([key, asset]) => {
        let downloadUrl = asset.browser_download_url ?? asset.url;

        if (!asset.browser_download_url && downloadUrl?.includes("api.github.com")) {
          try {
            const assetRes = await fetch(downloadUrl);
            if (assetRes.ok) {
              const assetData = (await assetRes.json()) as { browser_download_url?: string };
              if (assetData.browser_download_url) {
                downloadUrl = assetData.browser_download_url;
              }
            }
          } catch { /* keep original url */ }
        }

        if (downloadUrl) {
          resolvedPlatforms[key] = { browser_download_url: downloadUrl };
        }
      }),
    );

    release = {
      version: manifest.version,
      notes: manifest.notes,
      pub_date: manifest.pub_date,
      platforms: resolvedPlatforms,
    };
  }
} catch {
  release = fallbackRelease;
}
---

<Layout
  title={`Modpack Store - Canary ${release.version}`}
  description={`Modpack Store canary ${release.version}: ${release.notes}`}
>
  <!-- Google TV Cinematic Ambient Light Background -->
  <div class="fixed inset-0 z-[-1] pointer-events-none overflow-hidden bg-[#09090b]">
    <div
      class="absolute left-1/2 -translate-x-1/2 -top-24 h-[500px] w-[850px] rounded-full bg-primary/10 blur-[140px] animate-pulse-slow"
    >
    </div>
    <div
      class="absolute right-[-10%] top-[40%] h-[400px] w-[500px] rounded-full bg-purple-600/5 blur-[150px]"
    >
    </div>
    <div
      class="absolute left-[-10%] bottom-[20%] h-[400px] w-[500px] rounded-full bg-blue-600/5 blur-[150px]"
    >
    </div>
  </div>

  <main class="relative z-10 flex flex-col gap-16 sm:gap-20 pb-16 pt-8">
    <Hero release={release} />
    <TrustedCommunities />
    <Features />
    <DownloadSection release={release} />
    <!--script
      async="async"
      data-cfasync="false"
      src="https://pl31260735.profitableratecpmnetwork.com/a40d8c1ec3644f1ce38250c2169d5697/invoke.js"
    ></script-->
    <div id="container-a40d8c1ec3644f1ce38250c2169d5697"></div>
  </main>

  <Footer />
</Layout>
