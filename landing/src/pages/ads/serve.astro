---
function decodeBase64Url(input: string): Uint8Array {
  let base64 = input.replace(/-/g, "+").replace(/_/g, "/");
  const pad = base64.length % 4;
  if (pad === 2) base64 += "==";
  else if (pad === 3) base64 += "=";
  const binary = atob(base64);
  const bytes = new Uint8Array(binary.length);
  for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
  return bytes;
}

function decodePayload(raw: string): Record<string, unknown> | null {
  try {
    const bytes = decodeBase64Url(raw);
    const json = new TextDecoder("utf-8").decode(bytes);
    return JSON.parse(json);
  } catch {
    return null;
  }
}

function isSafeUrl(url: string): boolean {
  try {
    const parsed = new URL(url);
    return parsed.protocol === "http:" || parsed.protocol === "https:";
  } catch {
    if (url.startsWith("//")) return true;
    return false;
  }
}

function isSafeId(id: string): boolean {
  return /^[a-zA-Z0-9_-]+$/.test(id);
}

function isReasonableSize(value: string): boolean {
  if (/^\d+(\.\d+)?(px|rem|em|%)$/.test(value)) return true;
  const n = parseInt(value, 10);
  return !isNaN(n) && n > 0 && n < 10000;
}

const payload = Astro.url.searchParams.get("payload");

let config: Record<string, unknown> | null = null;

if (payload) {
  const parsed = decodePayload(payload);

  if (
    parsed &&
    typeof parsed.scriptSrc === "string" &&
    isSafeUrl(parsed.scriptSrc) &&
    (parsed.containerId === undefined || (typeof parsed.containerId === "string" && isSafeId(parsed.containerId)))
  ) {
    if (
      (parsed.width === undefined || (typeof parsed.width === "string" && isReasonableSize(parsed.width))) &&
      (parsed.height === undefined || (typeof parsed.height === "string" && isReasonableSize(parsed.height))) &&
      (parsed.format === undefined || typeof parsed.format === "string") &&
      (parsed.zoneId === undefined || (typeof parsed.zoneId === "string" && isSafeId(parsed.zoneId))) &&
      (parsed.insClass === undefined || (typeof parsed.insClass === "string" && isSafeId(parsed.insClass))) &&
      (parsed.settings === undefined || (typeof parsed.settings === "object" && parsed.settings !== null && !Array.isArray(parsed.settings))) &&
      (parsed.options === undefined || (typeof parsed.options === "object" && parsed.options !== null && !Array.isArray(parsed.options))) &&
      (parsed.scriptAttrs === undefined || (typeof parsed.scriptAttrs === "object" && parsed.scriptAttrs !== null && !Array.isArray(parsed.scriptAttrs)))
    ) {
      config = parsed;
    }
  }
}

function escapeHtml(s: string): string {
  return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

let bodyHtml = "";

if (config) {
  const containerId = (config.containerId as string) || "";
  const scriptSrc = config.scriptSrc as string;
  const native = config.native === true;
  const format = config.format as string | undefined;
  const width = (config.width as string) || "100%";
  const height = (config.height as string) || "100%";

  const S_TAG = "<" + "script";
  const S_END = "<" + "/script>";

  if (format === "hilltopads") {
    const settingsJson = JSON.stringify(config.settings || {});
    bodyHtml = `${S_TAG}>
(function(pbqc){
var d = document,
    s = d.createElement('script'),
    l = d.currentScript || d.scripts[d.scripts.length - 1];
s.settings = pbqc || {};
s.src = ${JSON.stringify(scriptSrc)};
s.async = true;
s.referrerPolicy = 'no-referrer-when-downgrade';
l.parentNode.insertBefore(s, l);
})(${settingsJson});
${S_END}`;
  } else if (format === "exoclick") {
    const zoneId = escapeHtml(String(config.zoneId || ""));
    const insClass = escapeHtml(String(config.insClass || "eas6a97888e2"));
    bodyHtml = `<ins class="${insClass}" data-zoneid="${zoneId}"></ins>${S_TAG} async type="application/javascript" src="${escapeHtml(scriptSrc)}">${S_END}${S_TAG}>(AdProvider = window.AdProvider || []).push({"serve": {}});${S_END}`;
  } else {
    const optionsScript = config.options
      ? `${S_TAG}>window.atOptions=${JSON.stringify(config.options)};${S_END}`
      : "";

    let scriptAttrsStr = "";
    const scriptAttrs = config.scriptAttrs as Record<string, string> | undefined;
    if (scriptAttrs) {
      for (const [key, value] of Object.entries(scriptAttrs)) {
        if (/^[a-zA-Z][a-zA-Z0-9_-]*$/.test(key) && typeof value === "string") {
          scriptAttrsStr += ` ${escapeHtml(key)}="${escapeHtml(value)}"`;
        }
      }
    }

    let containerHtml = "";
    if (native && containerId) {
      const containerStyle = `width:${width};height:${height};max-height:200px;overflow:hidden;`;
      containerHtml = `<div id="${escapeHtml(containerId)}" style="${escapeHtml(containerStyle)}"></div>`;
    }

    bodyHtml = `${containerHtml}${optionsScript}${S_TAG}${scriptAttrsStr} src="${escapeHtml(scriptSrc)}">${S_END}`;
  }
}
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <base target="_blank" />
    <style>
      html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: transparent;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      * { box-sizing: border-box; }
    </style>
  </head>
  <body set:html={bodyHtml}></body>
</html>
