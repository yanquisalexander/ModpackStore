{
    "tasks": {
        "start": "deno run --allow-net --allow-read --allow-env --allow-write --env-file=.env src/index.ts",
        "dev": "deno run --allow-net --allow-read --allow-env --allow-write --env-file=.env --watch src/index.ts"
    },
    "imports": {
        "@/": "./src/",
        "@shared/": "../shared/",
        "@hono/hono": "jsr:@hono/hono@^4.12.23",
        "@types/pg": "npm:@types/pg@^8.20.0",
        "drizzle-kit": "npm:drizzle-kit@^0.31.10",
        "drizzle-orm": "npm:drizzle-orm@^0.45.2",
        "pg": "npm:pg@^8.21.0"
    }
}