# Servidor
PORT=3000
CORS_ORIGIN=*
DATABASE_URL="postgresql://postgres:password@localhost:5432/modpackstore"

# Serverless optimization (Deno Deploy)
# Set to "true" to skip seeds, Redis/BullMQ init, and other heavy cold-start operations
SERVERLESS_ENVIRONMENT=false

# Discord OAuth
# DISCORD_CALLBACK_URL must match the redirect_uri registered in Discord Dev Portal
# HTTP mode: http://localhost:1957/callback
# Schema mode: modpackstore://oauth-callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=

# hCaptcha
HCAPTCHA_SECRET=

# JWT
JWT_SECRET=
