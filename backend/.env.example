# Servidor
PORT=3000
CORS_ORIGIN=*
DATABASE_URL="postgresql://postgres:password@localhost:5432/modpackstore"

# Serverless optimization (Deno Deploy)
# Set to "true" to skip seeds, Redis/BullMQ init, and other heavy cold-start operations
SERVERLESS_ENVIRONMENT=false

# Discord OAuth
# DISCORD_CALLBACK_URL must match the redirect_uri registered in Discord Dev Portal
# HTTP mode: http://localhost:1957/callback
# Schema mode: modpackstore://oauth-callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=

# Twitch OAuth
# TWITCH_REDIRECT_URI must match the redirect_uri used by the Tauri app
# (`http://localhost:1958/callback`) and be registered in the Twitch Dev Console.
# El backend acepta `redirect_uri` por petición, pero esta var es el fallback.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:1958/callback

# hCaptcha
HCAPTCHA_SECRET=

# JWT
JWT_SECRET=

# Mojang API Proxy (for SkinsRestorer compatibility)
# Optional: Override Mojang API endpoints if needed
# MOJANG_API_BASE_URL=https://api.mojang.com
# MOJANG_SESSION_SERVER_BASE_URL=https://sessionserver.mojang.com
# MOJANG_TIMEOUT_MS=10000
